# control-app Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase service role key.
# Never expose this value in Tampermonkey, browser code, or public repositories.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret pepper used to HMAC/hash license tokens and optional account tokens.
# Raw tokens are also stored in this test project, but hashes are kept for lookup/blocking flexibility.
# Generate one with: openssl rand -hex 32
TOKEN_PEPPER=replace-with-a-long-random-secret

# Required by admin endpoints and the tiny /admin page.
ADMIN_API_KEY=replace-with-a-long-admin-key

# Optional fallback when the database setting does not exist.
# Valid values: open, soft, strict
DEFAULT_ENFORCEMENT_MODE=open
